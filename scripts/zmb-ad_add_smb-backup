#!/bin/bash
# Adds the daily samba AD backup (/usr/local/bin/smb-backup) to an existing
# zmb-ad or zmb-ad-join container, the same way the installers set it up.
#
# Run it on the Proxmox host, from the directory of the toolbox:
#   scripts/zmb-ad_add_smb-backup CTID [BACKUP_DIR]
# BACKUP_DIR is the directory inside the container (default: /backup).
#
# The online backup authenticates with the administrator keytab
# /root/admin.keytab; it is exported if the container has none yet.

set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: $0 CTID [BACKUP_DIR]" >&2
  exit 2
fi
ctid=$1
backup_dir=${2:-/backup}
backup_dir=${backup_dir#/}

cd "$(dirname "$0")/.."
pct push "$ctid" src/functions.sh /root/zamba-functions.sh

pct exec "$ctid" -- bash -s "$backup_dir" <<'EOF'
set -euo pipefail
source /root/zamba-functions.sh
rm -f /root/zamba-functions.sh

realm=$(awk -F '=' '/^[[:space:]]*realm[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print toupper($2) }' /etc/samba/smb.conf)
if [ -z "$realm" ]; then
  echo "No realm in /etc/samba/smb.conf: this container is no samba AD DC." >&2
  exit 1
fi

if [ ! -s /root/admin.keytab ]; then
  echo "Exporting the keytab of administrator@$realm to /root/admin.keytab"
  samba-tool domain exportkeytab /root/admin.keytab --principal="administrator@$realm"
  chmod 600 /root/admin.keytab
fi

# a DC's DNS name is its host name in the domain of the realm
LXC_SHAREFS_MOUNTPOINT=$1
LXC_HOSTNAME=$(hostname -s)
LXC_DOMAIN=${realm,,}
inst_smb_backup
echo "smb-backup installed: /usr/local/bin/smb-backup, settings in /etc/default/smb-backup, runs daily at 23:00"
EOF
